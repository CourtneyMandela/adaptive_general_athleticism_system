# Copy to a secret-managed environment file outside version control.
# Replace every example value before starting the reference deployment.
AGAS_POSTGRES_PASSWORD=replace-with-a-long-random-password
AGAS_DATABASE_URL=postgresql+psycopg://agas:replace-with-a-url-encoded-password@postgres:5432/agas

AGAS_EXTERNAL_AUTH_ISSUER=https://identity.example/
AGAS_EXTERNAL_AUTH_AUDIENCE=https://api.agas.example
AGAS_EXTERNAL_AUTH_JWKS_URL=https://identity.example/.well-known/jwks.json
AGAS_EXTERNAL_AUTH_ALGORITHMS=["RS256"]
AGAS_CORS_ORIGINS=["https://app.agas.example"]

# Same-origin browser gateway. These public values are compiled into the PWA image.
NEXT_PUBLIC_API_URL=/api/agas
NEXT_PUBLIC_AGAS_AUTH_MODE=session

# Server-only web gateway configuration.
AGAS_INTERNAL_API_URL=http://api:8000
AGAS_PUBLIC_WEB_ORIGIN=https://app.agas.example
# Generate 32 random bytes and encode them as unpadded base64url. Never commit the real value.
AGAS_SESSION_ENCRYPTION_KEY=replace-with-a-32-byte-base64url-key

# Explicit provider-neutral OIDC browser-login contract.
# Compose reuses AGAS_EXTERNAL_AUTH_ISSUER and AGAS_EXTERNAL_AUTH_JWKS_URL for the web verifier.
AGAS_OIDC_AUTHORIZATION_URL=https://identity.example/oauth2/authorize
AGAS_OIDC_TOKEN_URL=https://identity.example/oauth2/token
AGAS_OIDC_CLIENT_ID=replace-with-the-confidential-web-client-id
AGAS_OIDC_CLIENT_SECRET=replace-with-the-confidential-web-client-secret
AGAS_OIDC_SCOPES=openid agas:api
# Some providers, including Auth0 custom APIs, select the access-token API with audience.
AGAS_OIDC_AUDIENCE=https://api.agas.example
AGAS_OIDC_RESOURCE=https://api.agas.example
AGAS_OIDC_ID_TOKEN_ALGORITHMS=RS256
AGAS_WEB_LOOPBACK_PORT=3000
