AGAS_ENVIRONMENT=development
AGAS_DATABASE_URL=postgresql+psycopg://agas:agas@localhost:5432/agas
AGAS_AUTH_MODE=development
AGAS_DEVELOPMENT_AUTH_ISSUER=urn:agas:development
# Production resource-server settings; keep these server-only and set all three with external mode.
# AGAS_EXTERNAL_AUTH_ISSUER=https://identity.example/
# AGAS_EXTERNAL_AUTH_AUDIENCE=https://api.agas.example
# AGAS_EXTERNAL_AUTH_JWKS_URL=https://identity.example/.well-known/jwks.json
# AGAS_EXTERNAL_AUTH_ALGORITHMS=["RS256"]
# AGAS_EXTERNAL_AUTH_LEEWAY_SECONDS=30
# AGAS_EXTERNAL_AUTH_JWKS_TIMEOUT_SECONDS=5
# AGAS_EXTERNAL_AUTH_JWKS_CACHE_SECONDS=300
AGAS_CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AGAS_DEVELOPMENT_TOKEN=dev.local-browser
NEXT_PUBLIC_AGAS_REVIEWER_TOKEN=dev.local-reviewer
NEXT_PUBLIC_AGAS_ASSESSMENT_REVIEWER_TOKEN=dev.local-assessment-reviewer
NEXT_PUBLIC_AGAS_ATHLETE_ID=
